{
  "name": "bongshai-steel-node-app",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "verify": "node scripts/verify-phase0.js",
    "db:check": "node scripts/db-check.js",
    "db:migrate": "knex --knexfile db/knexfile.js migrate:latest",
    "db:rollback": "knex --knexfile db/knexfile.js migrate:rollback",
    "db:import": "node scripts/import-flatfile.js",
    "verify:catalog": "node scripts/verify-catalog.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "compression": "^1.7.4",
    "connect-session-knex": "^5.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "helmet": "^7.1.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.4",
    "nunjucks": "^3.2.4"
  }
}
