# Copy to server/.env (git-ignored). On the host, set these in the cPanel
# Node.js Selector UI instead — never commit real values.

NODE_ENV=production
PORT=3000

# Redirect every request to https://<this host>. Leave unset locally.
CANONICAL_HOST=www.bongshaisteel.com

# lead intake (defaults shown)
LEAD_RATE=5
LEAD_WINDOW=600
MAX_LEADS=2000
# Salt for the hashed sender address stored with each lead. Any long random string.
LEAD_SALT=
