{% extends "layout.njk" %}

{% block breadcrumb_items %}
  <span>Projects</span>
{% endblock %}

{% block head_extra %}
<style>
  .proj-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 20px; margin-bottom: 60px; }
  .proj-card { background: var(--bg-card, #fff); border: 1px solid var(--border-light); border-radius: var(--radius-md, 14px); overflow: hidden; display: flex; flex-direction: column; }
  .proj-thumb { aspect-ratio: 16 / 10; background: linear-gradient(135deg, #e8f0fb, #cfe0f5); display: flex; align-items: center; justify-content: center; font-size: 2.6rem; }
  .proj-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .proj-body { padding: 16px 18px 18px; }
  .proj-body h3 { font-size: 1.05rem; margin: 0 0 6px; }
  .proj-where { color: var(--text-muted); font-size: 0.9rem; }
  .proj-list { display: grid; gap: 14px; margin-bottom: 50px; }
  .proj-row { display: grid; grid-template-columns: 120px 1fr; gap: 18px; padding: 18px 20px; border: 1px solid var(--border-light); border-radius: var(--radius-md, 14px); background: var(--bg-card, #fff); }
  .proj-year { font-weight: 800; color: var(--primary-navy); }
  .proj-type { display: inline-block; font-size: 0.72rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; color: var(--text-muted); margin-top: 4px; }
  .proj-row h3 { font-size: 1.05rem; margin: 0 0 6px; }
  .proj-meta { font-size: 0.9rem; color: var(--text-muted); line-height: 1.6; }
  .proj-clients { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 50px; }
  .proj-clients span { background: rgba(4,102,200,.08); border: 1px solid var(--border-light); border-radius: 20px; padding: 6px 14px; font-size: 0.85rem; font-weight: 700; color: var(--primary-navy); }
  @media (max-width: 560px) { .proj-row { grid-template-columns: 1fr; gap: 6px; } }
</style>
{% endblock %}

{% block content %}
<div class="container" style="padding-bottom: 80px;">

  <div class="section-header" style="text-align: left; margin-bottom: 30px;">
    <span class="section-subtitle">Built, finished and handed over</span>
    <h1 class="section-title" style="font-size: 2.2rem;">Completed Projects</h1>
    <p style="font-size: 1.05rem; color: var(--text-muted); max-width: 820px; margin-top: 10px;">
      Steel buildings delivered by Bongshai Steel, and the wider Bongshai Group's engineering projects in Bangladesh and Qatar since 2008.
    </p>
  </div>

  {% if steel.length %}
  <section>
    <h2 class="section-title" style="font-size: 1.5rem; text-align: left; margin-bottom: 18px;">Steel buildings by Bongshai Steel</h2>
    <div class="proj-grid">
      {% for p in steel %}
      <article class="proj-card">
        <div class="proj-thumb">
          {% if p.imageSrc %}
          <img src="{{ p.imageSrc.src }}" {% if p.imageSrc.srcset %}srcset="{{ p.imageSrc.srcset }}" sizes="(max-width: 600px) 100vw, 320px"{% endif %} alt="{{ p.title }}, {{ p.location }}" loading="lazy">
          {% else %}🏗️{% endif %}
        </div>
        <div class="proj-body">
          <h3>{{ p.title }}</h3>
          <div class="proj-where">📍 {{ p.location }}</div>
          {% if p.summary %}<p class="proj-meta" style="margin-top:8px;">{{ p.summary }}</p>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if engineering.length %}
  <section>
    <h2 class="section-title" style="font-size: 1.5rem; text-align: left; margin-bottom: 6px;">Bongshai Group track record</h2>
    <p style="color: var(--text-muted); margin-bottom: 18px;">Delivered by Bongshai Engineering &amp; Construction, Bongshai Steel's sister company. Newest first.</p>
    <div class="proj-list">
      {% for p in engineering %}
      <article class="proj-row">
        <div>
          <div class="proj-year">{{ p.year_label }}</div>
          {% if p.category %}<span class="proj-type">{{ p.category }}</span>{% endif %}
        </div>
        <div>
          <h3>{{ p.title }}</h3>
          <div class="proj-meta">
            {% if p.client %}<strong>Client:</strong> {{ p.client }}<br>{% endif %}
            {% if p.principal_contractor %}<strong>Principal contractor:</strong> {{ p.principal_contractor }}<br>{% endif %}
            {% if p.location %}<strong>Location:</strong> {{ p.location }}<br>{% endif %}
            {% if p.scope %}<strong>Scope:</strong> {{ p.scope }}{% endif %}
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {% if clients.length %}
  <section>
    <h2 class="section-title" style="font-size: 1.3rem; text-align: left; margin-bottom: 14px;">Clients include</h2>
    <div class="proj-clients">{% for c in clients %}<span>{{ c }}</span>{% endfor %}</div>
  </section>
  {% endif %}

  <section class="answer-box" style="text-align:center;">
    <p style="margin-bottom:16px;"><strong>Planning a steel building?</strong> Send your location, building size and requirements — the engineering team replies with a site-visit plan or a quotation.</p>
    <a href="/#contact" class="btn-primary-hero">Request a Quote</a>
  </section>
</div>
{% endblock %}
