{% extends "admin/layout.njk" %}

{% block title %}Products Management{% endblock %}

{% block header %}
<h1 style="font-size:1.25rem; font-weight:700; margin:0; color:var(--grey-900);">Products Management</h1>
{% endblock %}

{% block content %}
<div class="card">
  <form method="get" action="/admin/products" class="toolbar">
    <div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; flex:1;">
      <input
        type="text"
        name="q"
        value="{{ q or '' }}"
        placeholder="Search model code, name..."
        style="padding:8px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.9rem; min-width:220px; background:rgba(255,255,255,0.9);"
      >
      <select name="category" style="padding:8px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.9rem; background:rgba(255,255,255,0.9);">
        <option value="all" {% if category == 'all' or not category %}selected{% endif %}>All Categories</option>
        {% for cat in categories %}
        <option value="{{ cat.key }}" {% if category == cat.key %}selected{% endif %}>{{ cat.name }}</option>
        {% endfor %}
      </select>
      <button type="submit" class="btn btn-primary btn-sm">Filter</button>
      {% if q or (category and category != 'all') %}
      <a href="/admin/products" class="btn btn-sm">Clear</a>
      {% endif %}
    </div>
    <div>
      <a href="/admin/products/new" class="btn btn-primary">➕ Add Product</a>
    </div>
  </form>

  <div style="margin-bottom:14px; font-size:0.86rem; color:var(--grey-600); font-weight:600;">
    Total Products: {{ total if total is defined and total !== null else products.length }}
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th style="width:68px;">Image</th>
          <th style="width:130px;">Model Code</th>
          <th>Product Name</th>
          <th style="width:150px;">Category</th>
          <th style="width:70px;">Order</th>
          <th style="width:140px;">Status</th>
          <th style="width:90px; text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for p in products %}
        <tr>
          <td>
            {% if p.image %}
            <img
              src="{% for part in p.image.split('/') %}{% if part %}/{{ part | urlencode }}{% endif %}{% endfor %}"
              alt="{{ p.name }}"
              class="product-thumb"
              loading="lazy"
            >
            {% else %}
            <div class="product-thumb placeholder-thumb">No img</div>
            {% endif %}
          </td>
          <td>
            <code style="font-size:0.88rem; font-weight:700; color:var(--primary);">{{ p.model_code }}</code>
          </td>
          <td>
            <strong style="color:var(--grey-900); font-size:0.94rem;">{{ p.name }}</strong>
          </td>
          <td>
            <span class="pill pill-muted">{{ p.category_name or 'General' }}</span>
          </td>
          <td>
            <span style="font-family:monospace; color:var(--grey-600); font-weight:600;">#{{ p.sort_order if p.sort_order is defined and p.sort_order !== null else 0 }}</span>
          </td>
          <td>
            <div style="display:flex; gap:4px; flex-wrap:wrap;">
              {% if p.featured %}
              <span class="pill pill-gold">Featured</span>
              {% endif %}
              {% if p.published %}
              <span class="pill pill-success">Live</span>
              {% else %}
              <span class="pill pill-danger">Draft</span>
              {% endif %}
            </div>
          </td>
          <td style="text-align:right; white-space:nowrap;">
            <a href="/admin/products/{{ p.id }}/edit" class="btn btn-sm">Edit</a>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="7" style="text-align:center; padding:36px 20px; color:var(--grey-500);">
            No products found matching your search. <a href="/admin/products/new">Add a new product</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>
{% endblock %}
