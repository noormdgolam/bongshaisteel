{% extends "admin/layout.njk" %}

{% block title %}Media Library{% endblock %}

{% block header %}
<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; width:100%;">
  <div>
    <h1 style="font-size:1.25rem; font-weight:700; margin:0; color:var(--grey-900);">Media Library</h1>
    <div style="font-size:0.85rem; color:var(--grey-500); margin-top:2px;">Upload and manage site photos, optimized as WebP with responsive variants</div>
  </div>
</div>
{% endblock %}

{% block content %}
{% if notice %}
<div class="notice-box">{{ notice }}</div>
{% endif %}
{% if error %}
<div class="error-box">{{ error }}</div>
{% endif %}

{% if uploaded %}
<div class="notice-box" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px; border-left:4px solid var(--success);">
  <div>
    <strong>Just uploaded:</strong> <code>{{ uploaded }}</code>
    <div style="font-size:0.85rem; margin-top:4px;">Copy this path to use in products, categories or site sections:</div>
  </div>
  <div style="min-width:260px; flex:1; max-width:480px;">
    <input
      type="text"
      readonly
      value="{{ uploaded }}"
      onclick="this.select();"
      style="width:100%; padding:8px 12px; font-family:monospace; font-size:0.88rem; font-weight:600; background:#ffffff; border:1px solid rgba(22, 163, 74, 0.4); border-radius:6px; color:#15803d;"
    >
  </div>
</div>
{% endif %}

<!-- Upload Card -->
<div class="card" style="margin-bottom:24px;">
  <h2 style="font-size:1.05rem; font-weight:700; margin:0 0 12px; color:var(--grey-900);">Upload New Image</h2>

  {% if available === false %}
  <div class="error-box" style="margin-bottom:14px; background:rgba(254, 243, 199, 0.9); color:#92400e; border-color:rgba(245, 158, 11, 0.4);">
    Image processing is currently unavailable on this server. Image uploads are disabled.
  </div>
  {% endif %}

  <form method="post" action="/admin/media" enctype="multipart/form-data">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div style="display:flex; align-items:flex-start; gap:14px; flex-wrap:wrap;">
      <div style="flex:1; min-width:260px;">
        <input
          type="file"
          name="file"
          accept="image/jpeg,image/png,image/webp,image/gif"
          required
          {% if available === false %}disabled{% endif %}
          style="width:100%; padding:9px 12px; border:1px dashed var(--grey-300); border-radius:8px; background:rgba(255,255,255,0.7); font-size:0.9rem;"
        >
        <div style="font-size:0.82rem; color:var(--grey-500); margin-top:6px;">
          JPEG, PNG, WebP or GIF, up to {{ maxMB }} MB. Stored as WebP with 400px and 700px versions.
        </div>
      </div>
      <div>
        <button
          type="submit"
          class="btn btn-primary"
          {% if available === false %}disabled{% endif %}
          style="white-space:nowrap; height:42px;"
        >
          Upload Image
        </button>
      </div>
    </div>
  </form>
</div>

<!-- Media Items List -->
<div class="card">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:8px;">
    <h2 style="font-size:1.05rem; font-weight:700; margin:0; color:var(--grey-900);">Uploaded Files</h2>
    <div style="font-size:0.86rem; color:var(--grey-600); font-weight:600;">
      Total: {{ items.length }} file{% if items.length != 1 %}s{% endif %}
    </div>
  </div>

  {% if items and items.length %}
  <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(300px, 1fr)); gap:16px;">
    {% for item in items %}
    <div
      class="card"
      style="margin:0; padding:16px; display:flex; flex-direction:column; gap:12px; background:rgba(255,255,255,0.85); border:1px solid {% if uploaded and item.path == uploaded %}var(--primary){% else %}var(--grey-200){% endif %}; {% if uploaded and item.path == uploaded %}box-shadow:0 0 0 2px rgba(14, 116, 144, 0.25);{% endif %}"
    >
      <div style="display:flex; gap:12px; align-items:flex-start;">
        <div style="width:72px; height:72px; flex-shrink:0; border-radius:8px; overflow:hidden; border:1px solid var(--grey-200); background:#f8fafc; display:flex; align-items:center; justify-content:center;">
          <img
            src="{% for part in item.path.split('/') %}{% if part %}/{{ part | urlencode }}{% endif %}{% endfor %}"
            alt="{{ item.name }}"
            loading="lazy"
            style="width:100%; height:100%; object-fit:cover;"
          >
        </div>

        <div style="flex:1; min-width:0;">
          <div style="display:flex; align-items:center; justify-content:space-between; gap:6px;">
            <strong style="color:var(--grey-900); font-size:0.92rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;" title="{{ item.name }}">
              {{ item.name }}
            </strong>
            {% if uploaded and item.path == uploaded %}
            <span class="pill pill-gold" style="font-size:0.7rem; flex-shrink:0;">Just uploaded</span>
            {% endif %}
          </div>

          <div style="font-size:0.80rem; color:var(--grey-500); margin-top:3px;">
            <span>{{ (item.bytes / 1024) | round }} KB</span>
            <span> · </span>
            <span>{{ item.modified | dhaka }}</span>
          </div>

          {% if item.variants and item.variants.length %}
          <div style="display:flex; gap:4px; margin-top:4px; flex-wrap:wrap;">
            {% for v in item.variants %}
            <span class="pill pill-muted" style="font-size:0.68rem; padding:1px 6px;">{{ v }}w</span>
            {% endfor %}
          </div>
          {% endif %}
        </div>
      </div>

      <!-- Copy Path Input -->
      <div>
        <label style="display:block; font-size:0.74rem; font-weight:700; text-transform:uppercase; color:var(--grey-500); margin-bottom:4px; letter-spacing:0.03em;">
          Site Path (click to select)
        </label>
        <input
          type="text"
          readonly
          value="{{ item.path }}"
          onclick="this.select();"
          style="width:100%; padding:6px 10px; font-family:monospace; font-size:0.80rem; background:rgba(241, 245, 249, 0.8); border:1px solid var(--grey-300); border-radius:6px; color:var(--grey-800);"
        >
      </div>

      <!-- Usage and Delete Actions -->
      <div style="margin-top:auto; padding-top:10px; border-top:1px dashed rgba(15, 23, 42, 0.08); display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:wrap;">
        {% if item.usedBy and item.usedBy.length %}
        <div style="font-size:0.78rem; color:var(--grey-600);">
          <strong style="color:var(--grey-700);">Used by:</strong>
          <div style="display:flex; gap:4px; flex-wrap:wrap; margin-top:3px;">
            {% for u in item.usedBy %}
            <span class="pill pill-info" style="font-size:0.72rem; padding:1px 7px;">{{ u }}</span>
            {% endfor %}
          </div>
        </div>
        {% else %}
        <div style="font-size:0.78rem; color:var(--grey-400); font-style:italic;">
          Not used anywhere
        </div>
        <form method="post" action="/admin/media/delete" onsubmit="return confirm('Delete image \'{{ item.name }}\'? This cannot be undone.');" style="margin:0;">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <input type="hidden" name="path" value="{{ item.path }}">
          <button type="submit" class="btn btn-sm btn-danger" style="font-size:0.8rem; padding:4px 10px;">
            Delete
          </button>
        </form>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div style="text-align:center; padding:40px 20px; color:var(--grey-500); background:rgba(255,255,255,0.6); border-radius:10px; border:1px dashed var(--grey-300);">
    No media files uploaded yet. Choose an image above to upload.
  </div>
  {% endif %}
</div>
{% endblock %}
