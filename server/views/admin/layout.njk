<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{% block title %}Admin{% endblock %} — Bongshai Steel</title>
<meta name="robots" content="noindex, nofollow">
<style>
  :root {
    --primary: #1E40AF;
    --primary-dark: #1e3a8a;
    --primary-light: #3b82f6;
    --accent: #0284c7;
    --grey-50: #f8fafc;
    --grey-100: #f1f5f9;
    --grey-200: #e2e8f0;
    --grey-300: #cbd5e1;
    --grey-500: #64748b;
    --grey-600: #475569;
    --grey-700: #334155;
    --grey-900: #0f172a;
    --danger: #dc2626;
    --danger-bg: #fef2f2;
    --success: #16a34a;
    --success-bg: #f0fdf4;
    --warning: #b45309;
    --warning-bg: #fef3c7;
    --glass: rgba(255, 255, 255, 0.78);
    --glass-border: rgba(255, 255, 255, 0.55);
    --glass-sidebar: rgba(8, 18, 42, 0.75);
  }
  * { box-sizing: border-box; }
  html, body { min-height: 100%; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--grey-900);
    background:
      radial-gradient(circle at 10% 15%, rgba(2, 132, 199, 0.22), transparent 42%),
      radial-gradient(circle at 90% 10%, rgba(30, 64, 175, 0.28), transparent 45%),
      radial-gradient(circle at 50% 100%, rgba(15, 23, 42, 0.35), transparent 55%),
      linear-gradient(165deg, #0a1733 0%, #0e2754 38%, #163d7e 72%, #1e40af 100%);
    background-attachment: fixed;
    min-height: 100vh;
  }
  a { color: var(--primary); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .admin-shell { display: flex; min-height: 100vh; }
  .admin-sidebar {
    width: 230px; flex-shrink: 0; padding: 20px 0; color: white;
    background: var(--glass-sidebar);
    backdrop-filter: blur(20px) saturate(150%);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
  }
  .admin-sidebar .brand {
    padding: 0 20px 18px; font-weight: 800; font-size: 1.15rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.14); margin-bottom: 12px;
    letter-spacing: -0.02em; display: flex; align-items: center; gap: 8px;
  }
  .admin-sidebar nav { display: flex; flex-direction: column; gap: 3px; }
  .admin-sidebar nav a {
    display: flex; align-items: center; gap: 10px; padding: 10px 18px;
    color: #cbd5e1; border-radius: 8px; margin: 0 10px; font-size: 0.92rem;
    font-weight: 500; transition: background 0.15s, color 0.15s;
  }
  .admin-sidebar nav a svg { opacity: 0.75; flex-shrink: 0; }
  .admin-sidebar nav a:hover svg, .admin-sidebar nav a.active svg { opacity: 1; }
  .admin-sidebar nav a:hover, .admin-sidebar nav a.active {
    background: rgba(255, 255, 255, 0.14); color: #ffffff; text-decoration: none;
  }
  .admin-sidebar nav a.active {
    font-weight: 700; background: rgba(30, 64, 175, 0.55);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.2);
  }
  .admin-main { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .admin-topbar {
    display: flex; justify-content: space-between; align-items: center; padding: 14px 24px;
    background: rgba(255, 255, 255, 0.65);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
  }
  .admin-topbar-actions { display: flex; align-items: center; gap: 12px; }
  .user-badge {
    font-size: 0.88rem; font-weight: 600; color: var(--grey-700);
    padding: 4px 10px; border-radius: 20px; background: rgba(255, 255, 255, 0.8);
    border: 1px solid var(--grey-200);
  }
  .admin-content { padding: 24px; max-width: 1100px; width: 100%; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 8px 16px; border-radius: 8px; border: 1px solid rgba(15, 23, 42, 0.15);
    background: rgba(255, 255, 255, 0.8); backdrop-filter: blur(6px);
    color: var(--grey-900); cursor: pointer; font-size: 0.9rem; font-weight: 600;
    transition: all 0.15s ease;
  }
  .btn:hover { background: #ffffff; text-decoration: none; box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08); }
  .btn-sm { padding: 5px 12px; font-size: 0.82rem; }
  .btn-primary { background: var(--primary); border-color: var(--primary); color: #ffffff; }
  .btn-primary:hover { background: var(--primary-dark); }
  .btn-danger { color: var(--danger); border-color: rgba(220, 38, 38, 0.3); background: rgba(255, 255, 255, 0.85); }
  .btn-danger:hover { background: var(--danger-bg); border-color: var(--danger); }
  .card {
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid var(--glass-border);
    border-radius: 14px;
    padding: 20px;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.6);
    margin-bottom: 20px;
  }
  .notice-box {
    background: rgba(220, 252, 231, 0.9);
    color: #15803d;
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
  }
  .error-box {
    background: rgba(254, 242, 242, 0.9);
    color: var(--danger);
    border: 1px solid rgba(220, 38, 38, 0.3);
    border-radius: 8px;
    padding: 12px 16px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
  }
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; margin-bottom: 20px; }
  .stat-card {
    background: var(--glass);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    padding: 18px;
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.1);
  }
  .stat-card .num { font-size: 1.85rem; font-weight: 800; color: var(--primary); margin-bottom: 2px; }
  .stat-card .label { color: var(--grey-500); font-size: 0.84rem; font-weight: 600; }
  table {
    width: 100%; border-collapse: collapse; background: var(--glass);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--glass-border); border-radius: 12px;
    overflow: hidden; box-shadow: 0 6px 20px rgba(15, 23, 42, 0.1);
  }
  th, td { text-align: left; padding: 11px 14px; border-bottom: 1px solid rgba(15, 23, 42, 0.07); font-size: 0.9rem; }
  th { background: rgba(255, 255, 255, 0.45); color: var(--grey-600); font-weight: 700; text-transform: uppercase; font-size: 0.74rem; letter-spacing: 0.04em; }
  tr:last-child td { border-bottom: none; }
  .table-responsive { width: 100%; overflow-x: auto; border-radius: 12px; }
  .pill { display: inline-block; padding: 2px 10px; border-radius: 20px; font-size: 0.75rem; font-weight: 700; }
  .pill-success { background: var(--success-bg); color: var(--success); border: 1px solid rgba(22, 163, 74, 0.2); }
  .pill-danger { background: var(--danger-bg); color: var(--danger); border: 1px solid rgba(220, 38, 38, 0.2); }
  .pill-gold { background: var(--warning-bg); color: var(--warning); border: 1px solid rgba(180, 83, 9, 0.2); }
  .pill-muted { background: var(--grey-100); color: var(--grey-600); border: 1px solid var(--grey-200); }
  .toolbar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; gap: 12px; flex-wrap: wrap; }
  .form-row { margin-bottom: 16px; }
  .form-row label { display: block; font-weight: 600; font-size: 0.85rem; margin-bottom: 5px; color: var(--grey-700); }
  .form-row input[type=text], .form-row input[type=number], .form-row input[type=email], .form-row input[type=password], .form-row textarea, .form-row select {
    width: 100%; padding: 9px 12px; border: 1px solid rgba(15, 23, 42, 0.18); border-radius: 7px; font-size: 0.92rem; font-family: inherit; background: rgba(255, 255, 255, 0.75); color: var(--grey-900);
  }
  .form-row input:focus, .form-row textarea:focus, .form-row select:focus {
    outline: 2px solid var(--primary-light); outline-offset: 1px; background: #ffffff;
  }
  .form-actions { display: flex; gap: 10px; margin-top: 24px; align-items: center; flex-wrap: wrap; }
  .admin-mobilebar { display: none; }
  .admin-scrim { display: none; }
  .product-thumb { width: 52px; height: 52px; object-fit: cover; border-radius: 6px; border: 1px solid var(--grey-200); background: #ffffff; }
  .placeholder-thumb { display: flex; align-items: center; justify-content: center; font-size: 0.72rem; color: var(--grey-500); background: var(--grey-100); }

  @media (max-width: 900px) {
    .admin-mobilebar {
      display: flex; align-items: center; gap: 12px;
      position: sticky; top: 0; z-index: 60;
      padding: 10px 14px; color: #fff;
      background: rgba(8, 18, 42, 0.94);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    }
    .admin-menu-btn {
      display: grid; place-items: center; width: 38px; height: 38px;
      border-radius: 8px; border: 1px solid rgba(255, 255, 255, 0.22);
      background: rgba(255, 255, 255, 0.12); color: #fff; cursor: pointer;
    }
    .admin-mobilebar .brand { font-weight: 800; font-size: 1rem; }
    .admin-shell { flex-direction: column; }
    .admin-sidebar {
      position: fixed; top: 0; bottom: 0; left: 0; z-index: 70;
      width: 260px; max-width: 85vw; padding: 16px 0;
      transform: translateX(-100%);
      transition: transform 0.24s cubic-bezier(0.32, 0.72, 0, 1);
      overflow-y: auto;
    }
    .admin-sidebar.open { transform: translateX(0); }
    .admin-scrim {
      display: block; position: fixed; inset: 0; z-index: 65;
      background: rgba(3, 7, 18, 0.55); opacity: 0; pointer-events: none;
      transition: opacity 0.24s;
    }
    .admin-scrim.open { opacity: 1; pointer-events: auto; }
    .admin-topbar { padding: 12px 14px; flex-wrap: wrap; gap: 10px; }
    .admin-topbar-actions { flex-wrap: wrap; }
    .admin-content { padding: 14px; max-width: 100%; overflow-wrap: anywhere; }
    body { overflow-x: hidden; }
  }
  @media (prefers-reduced-motion: reduce) {
    .admin-sidebar, .admin-scrim { transition: none; }
  }
</style>
</head>
<body>
<div class="admin-mobilebar">
  <button class="admin-menu-btn" id="adminMenuBtn" type="button" aria-label="Open Navigation Menu" aria-expanded="false" aria-controls="adminSidebar">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <div class="brand">Bongshai Steel</div>
</div>
<div class="admin-scrim" id="adminScrim"></div>

<div class="admin-shell">
  <aside class="admin-sidebar" id="adminSidebar">
    <div class="brand">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M6 21V8l6-4 6 4v13M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01"/></svg>
      <span>Bongshai Steel</span>
    </div>
    <nav>
      <a href="/admin" class="{% if active == 'dashboard' %}active{% endif %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M4 20h16"/></svg>
        <span>Dashboard</span>
      </a>
      <a href="/admin/products" class="{% if active == 'products' %}active{% endif %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1M9 11h6M9 15h6M9 19h3"/></svg>
        <span>Products</span>
      </a>
      <a href="/admin/leads" class="{% if active == 'leads' %}active{% endif %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h4l2 3h4l2-3h4M4 12 5.5 5a1 1 0 0 1 1-1h11a1 1 0 0 1 1 1L20 12M4 12v6a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-6"/></svg>
        <span>Messages</span>
      </a>
      <a href="/admin/activity" class="{% if active == 'activity' %}active{% endif %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
        <span>Activity</span>
      </a>
      {% if adminRole == 'superadmin' or adminRole == 'admin' %}
      <a href="/admin/users" class="{% if active == 'users' %}active{% endif %}">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M2 20c0-3.3 3.1-6 7-6s7 2.7 7 6"/><circle cx="17" cy="9" r="2.5"/><path d="M16 13.5c2.9.4 5 2.3 5 4.5"/></svg>
        <span>Users</span>
      </a>
      {% endif %}
    </nav>
  </aside>
  <div class="admin-main">
    <div class="admin-topbar">
      <div>{% block header %}{% endblock %}</div>
      <div class="admin-topbar-actions">
        <span class="user-badge">{{ adminName }} ({{ adminRole }})</span>
        <form method="post" action="/admin/logout" style="display:inline; margin:0;">
          <input type="hidden" name="_csrf" value="{{ csrfToken }}">
          <button type="submit" class="btn btn-sm">Log out</button>
        </form>
      </div>
    </div>
    <div class="admin-content">
      {% if notice %}
      <div class="notice-box">{{ notice }}</div>
      {% endif %}
      {% if error %}
      <div class="error-box">{{ error }}</div>
      {% endif %}
      {% block content %}{% endblock %}
    </div>
  </div>
</div>
<script>
(function(){
  var btn = document.getElementById('adminMenuBtn');
  var bar = document.getElementById('adminSidebar');
  var scrim = document.getElementById('adminScrim');
  if (!btn || !bar || !scrim) return;

  function setOpen(open){
    bar.classList.toggle('open', open);
    scrim.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  btn.addEventListener('click', function(){ setOpen(!bar.classList.contains('open')); });
  scrim.addEventListener('click', function(){ setOpen(false); });
  document.addEventListener('keydown', function(e){ if (e.key === 'Escape') setOpen(false); });
  bar.addEventListener('click', function(e){ if (e.target.closest('a')) setOpen(false); });
})();
</script>
</body>
</html>
