{% extends "admin/layout.njk" %}

{% block title %}Dashboard{% endblock %}

{% block header %}
<h1 style="font-size:1.25rem; font-weight:700; margin:0; color:var(--grey-900);">Dashboard Overview</h1>
{% endblock %}

{% block content %}
<div class="toolbar" style="margin-bottom:20px;">
  <div style="font-size:0.95rem; color:#e2e8f0; font-weight:500;">
    Welcome to Bongshai Steel administration console.
  </div>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <a href="/admin/products/new" class="btn btn-primary btn-sm">➕ Add Product</a>
    <a href="/admin/products" class="btn btn-sm">📦 View Products</a>
    <a href="/admin/leads" class="btn btn-sm">📬 View Messages</a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card" style="border-left:4px solid var(--primary);">
    <div class="num">{{ stats.products if stats.products is defined and stats.products !== null else 0 }}</div>
    <div class="label">Total Products</div>
  </div>
  <div class="stat-card" style="border-left:4px solid var(--accent);">
    <div class="num">{{ stats.categories if stats.categories is defined and stats.categories !== null else 0 }}</div>
    <div class="label">Categories</div>
  </div>
  <div class="stat-card" style="border-left:4px solid #f59e0b;">
    <div class="num">{{ stats.faqs if stats.faqs is defined and stats.faqs !== null else 0 }}</div>
    <div class="label">FAQs Published</div>
  </div>
  <div class="stat-card" style="border-left:4px solid var(--success);">
    <div class="num">{{ stats.leadsNew if stats.leadsNew is defined and stats.leadsNew !== null else 0 }}</div>
    <div class="label">New Inquiries</div>
  </div>
  <div class="stat-card" style="border-left:4px solid #6366f1;">
    <div class="num">{{ stats.leadsTotal if stats.leadsTotal is defined and stats.leadsTotal !== null else 0 }}</div>
    <div class="label">Total Inquiries</div>
  </div>
  <div class="stat-card" style="border-left:4px solid #06b6d4;">
    <div class="num">{% if stats.views is defined and stats.views !== null %}{{ stats.views }}{% else %}—{% endif %}</div>
    <div class="label">Site Views</div>
  </div>
  <a href="/admin/analytics" class="stat-card" style="border-left:4px solid #1d4ed8; text-decoration:none; color:inherit;">
    <div class="num">{{ stats.visitorsToday or 0 }}</div>
    <div class="label">Visitors today · {{ stats.visitorsWeek or 0 }} this week</div>
  </a>
  <a href="/admin/chats?status=open" class="stat-card" style="border-left:4px solid #0d9488; text-decoration:none; color:inherit;">
    <div class="num">{{ stats.chatsOpen or 0 }}</div>
    <div class="label">Open support chats</div>
  </a>
  <a href="/admin/seo" class="stat-card" style="border-left:4px solid #b45309; text-decoration:none; color:inherit;">
    <div class="num">{{ stats.noSeo or 0 }}</div>
    <div class="label">Models without an SEO description</div>
  </a>
</div>

<div class="card" style="margin-top:24px;">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
    <h2 style="font-size:1.05rem; font-weight:700; margin:0; color:var(--grey-900);">Recent System Activity</h2>
    <a href="/admin/activity" class="btn btn-sm">All Activity Log</a>
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th style="width:170px;">Date &amp; Time</th>
          <th style="width:140px;">Admin</th>
          <th style="width:130px;">Action</th>
          <th>Summary</th>
        </tr>
      </thead>
      <tbody>
        {% for item in recentActivity %}
        <tr>
          <td style="white-space:nowrap; font-size:0.85rem; color:var(--grey-600);">
            {{ item.created_at | dhaka }}
          </td>
          <td>
            <strong style="color:var(--grey-900);">{{ item.admin_name }}</strong>
          </td>
          <td>
            <span class="pill pill-muted">{{ item.action }}</span>
          </td>
          <td style="color:var(--grey-700);">
            {{ item.summary }}
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="4" style="text-align:center; padding:36px 20px; color:var(--grey-500);">
            No recent activity recorded.
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="mobile-card-list">
    {% for item in recentActivity %}
    <div class="admin-mobile-card activity-card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px;">
        <strong style="color:var(--grey-900); font-size:0.92rem;">{{ item.admin_name }}</strong>
        <span class="pill pill-muted">{{ item.action }}</span>
      </div>
      <div style="font-size:0.8rem; color:var(--grey-600); margin-bottom:6px;">
        {{ item.created_at | dhaka }}
      </div>
      <div style="font-size:0.88rem; color:var(--grey-800); line-height:1.4;">
        {{ item.summary }}
      </div>
    </div>
    {% else %}
    <div class="admin-mobile-card" style="text-align:center; padding:28px 16px; color:var(--grey-500);">
      No recent activity recorded.
    </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
