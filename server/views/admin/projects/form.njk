{% extends "admin/layout.njk" %}

{% block title %}{% if project.id %}Edit Project: {{ project.title }}{% else %}New Project{% endif %}{% endblock %}

{% block header %}
<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; width:100%;">
  <div>
    <h1 style="font-size:1.25rem; font-weight:700; margin:0; color:var(--grey-900);">
      {% if project.id %}Edit Project: {{ project.title }}{% else %}New Project{% endif %}
    </h1>
    <div style="font-size:0.85rem; color:var(--grey-500); margin-top:2px;">
      <a href="/admin/projects" style="color:var(--primary); text-decoration:none;">&larr; Back to projects</a>
    </div>
  </div>
</div>
{% endblock %}

{% block content %}
<div style="max-width:820px;">
  {% if error %}
  <div class="banner banner-error" style="margin-bottom:20px;">
    {{ error }}
  </div>
  {% endif %}

  <div class="card">
    <form method="post" action="{% if project.id %}/admin/projects/{{ project.id }}{% else %}/admin/projects{% endif %}">
      <input type="hidden" name="_csrf" value="{{ csrfToken }}">

      <div style="display:flex; flex-direction:column; gap:18px;">
        <div>
          <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:6px; color:var(--grey-800);">
            Project Title <span style="color:var(--danger);">*</span>
          </label>
          <input
            type="text"
            name="title"
            value="{{ project.title or '' }}"
            required
            maxlength="255"
            placeholder="e.g. 5-Storey Pre-Engineered Steel Factory Building"
            style="width:100%; padding:9px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.95rem; background:rgba(255,255,255,0.95);"
          >
        </div>

        <div>
          <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:6px; color:var(--grey-800);">
            Delivered By <span style="color:var(--danger);">*</span>
          </label>
          <select
            name="delivered_by"
            required
            style="width:100%; padding:9px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.92rem; background:rgba(255,255,255,0.95);"
          >
            {% for g in groups %}
            <option value="{{ g.value }}" {% if (project.delivered_by or 'steel') == g.value %}selected{% endif %}>
              {{ g.label }}
            </option>
            {% endfor %}
          </select>
        </div>

        <div class="form-grid-2">
          <div>
            <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:6px; color:var(--grey-800);">
              Category
            </label>
            <input
              type="text"
              name="category"
              value="{{ project.category or '' }}"
              maxlength="60"
              placeholder="e.g. Steel Building, Commercial, Defense"
              style="width:100%; padding:9px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.92rem; background:rgba(255,255,255,0.95);"
            >
            <div style="font-size:0.8rem; color:var(--grey-500); margin-top:4px;">
              e.g. Steel Building, Commercial, Defense
            </div>
          </div>
          <div>
            <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:6px; color:var(--grey-800);">
              Year / Period
            </label>
            <input
              type="text"
              name="year_label"
              value="{{ project.year_label or '' }}"
              maxlength="20"
              placeholder="e.g. 2016 or 2008–2010"
              style="width:100%; padding:9px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.92rem; background:rgba(255,255,255,0.95);"
            >
            <div style="font-size:0.8rem; color:var(--grey-500); margin-top:4px;">
              2016 or 2008–2010
            </div>
          </div>
        </div>

        <div class="form-grid-2">
          <div>
            <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:6px; color:var(--grey-800);">
              Client Name
            </label>
            <input
              type="text"
              name="client"
              value="{{ project.client or '' }}"
              maxlength="255"
              placeholder="e.g. Akij Group"
              style="width:100%; padding:9px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.92rem; background:rgba(255,255,255,0.95);"
            >
          </div>
          <div>
            <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:6px; color:var(--grey-800);">
              Principal Contractor
            </label>
            <input
              type="text"
              name="principal_contractor"
              value="{{ project.principal_contractor or '' }}"
              maxlength="255"
              placeholder="e.g. Bongshai Engineering Ltd."
              style="width:100%; padding:9px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.92rem; background:rgba(255,255,255,0.95);"
            >
          </div>
        </div>

        <div>
          <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:6px; color:var(--grey-800);">
            Location
          </label>
          <input
            type="text"
            name="location"
            value="{{ project.location or '' }}"
            maxlength="255"
            placeholder="e.g. Gazipur, Dhaka"
            style="width:100%; padding:9px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.92rem; background:rgba(255,255,255,0.95);"
          >
        </div>

        <div>
          <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:6px; color:var(--grey-800);">
            Scope of Work
          </label>
          <textarea
            name="scope"
            maxlength="500"
            rows="3"
            placeholder="Key project scope and structural elements (max 500 characters)..."
            style="width:100%; padding:9px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.92rem; background:rgba(255,255,255,0.95); font-family:inherit;"
          >{{ project.scope or '' }}</textarea>
        </div>

        <div>
          <label style="display:block; font-weight:600; font-size:0.9rem; margin-bottom:6px; color:var(--grey-800);">
            Project Summary
          </label>
          <textarea
            name="summary"
            rows="5"
            placeholder="Detailed project summary, engineering specifications, or client results..."
            style="width:100%; padding:9px 12px; border:1px solid var(--grey-300); border-radius:7px; font-size:0.92rem; background:rgba(255,255,255,0.95); font-family:inherit;"
          >{{ project.summary or '' }}</textarea>
        </div>

        <!-- Photo Selection (Radio Group) -->
        <div style="border-top:1px solid var(--grey-200); padding-top:16px;">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px; flex-wrap:wrap; gap:8px;">
            <div>
              <label style="display:block; font-weight:700; font-size:0.95rem; color:var(--grey-900);">
                Project Photo
              </label>
              <div style="font-size:0.82rem; color:var(--grey-500); margin-top:2px;">
                Select a photo from the media library to display on the /projects page.
              </div>
            </div>
            <div>
              <a href="/admin/media" target="_blank" rel="noopener" class="btn btn-sm" style="font-size:0.82rem;">
                Upload photos ↗
              </a>
            </div>
          </div>

          {% if project.image %}
          <div style="margin-bottom:14px; padding:12px; background:rgba(241, 245, 249, 0.7); border:1px solid var(--grey-300); border-radius:8px; display:flex; align-items:center; gap:16px; flex-wrap:wrap;">
            <img
              src="{% for part in project.image.split('/') %}{% if part %}/{{ part | urlencode }}{% endif %}{% endfor %}"
              alt="Current photo"
              style="width:120px; height:80px; object-fit:cover; border-radius:6px; border:1px solid var(--grey-300); background:#fff;"
            >
            <div>
              <span class="pill pill-primary" style="font-size:0.75rem;">Current Photo</span>
              <div style="font-family:monospace; font-size:0.84rem; color:var(--grey-800); margin-top:4px;">{{ project.image }}</div>
            </div>
          </div>
          {% endif %}

          <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(130px, 1fr)); gap:12px; max-height:280px; overflow-y:auto; padding:10px; border:1px solid var(--grey-300); border-radius:8px; background:rgba(255,255,255,0.7);">
            <!-- No Photo Option -->
            <label style="display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:10px; border:1px dashed var(--grey-300); border-radius:8px; cursor:pointer; background:rgba(255,255,255,0.9); height:110px;">
              <input type="radio" name="image" value="" {% if not project.image %}checked{% endif %}>
              <span style="font-size:0.8rem; font-weight:600; color:var(--grey-600); margin-top:6px;">No photo</span>
            </label>

            <!-- Custom Selected Photo If Not in mediaPaths -->
            {% if project.image and (not mediaPaths or not (project.image in mediaPaths)) %}
            <label style="display:flex; flex-direction:column; align-items:center; text-align:center; padding:6px; border:2px solid var(--primary); border-radius:8px; cursor:pointer; background:#fff; height:110px; overflow:hidden;">
              <input type="radio" name="image" value="{{ project.image }}" checked>
              <img
                src="{% for part in project.image.split('/') %}{% if part %}/{{ part | urlencode }}{% endif %}{% endfor %}"
                alt="{{ project.image }}"
                style="width:100%; height:55px; object-fit:cover; border-radius:4px; margin-top:4px;"
                loading="lazy"
              >
              <span style="font-size:0.7rem; color:var(--grey-700); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; width:100%; margin-top:2px;">
                Current
              </span>
            </label>
            {% endif %}

            <!-- Media Paths Options -->
            {% for mp in mediaPaths %}
            <label style="display:flex; flex-direction:column; align-items:center; text-align:center; padding:6px; border:1px solid var(--grey-200); border-radius:8px; cursor:pointer; background:#fff; height:110px; overflow:hidden;">
              <input type="radio" name="image" value="{{ mp }}" {% if project.image == mp %}checked{% endif %}>
              <img
                src="{% for part in mp.split('/') %}{% if part %}/{{ part | urlencode }}{% endif %}{% endfor %}"
                alt="{{ mp }}"
                style="width:100%; height:55px; object-fit:cover; border-radius:4px; margin-top:4px;"
                loading="lazy"
              >
              <span style="font-size:0.68rem; color:var(--grey-600); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; width:100%; margin-top:2px;" title="{{ mp }}">
                {{ mp.split('/').pop() }}
              </span>
            </label>
            {% endfor %}
          </div>
        </div>

        <div>
          <label style="display:inline-flex; align-items:center; gap:8px; cursor:pointer; font-weight:600; font-size:0.9rem; color:var(--grey-800);">
            <input
              type="checkbox"
              name="published"
              value="1"
              {% if project.id %}{% if project.published %}checked{% endif %}{% else %}checked{% endif %}
              style="width:18px; height:18px; border-radius:4px; accent-color:var(--primary);"
            >
            <span>Published on /projects page</span>
          </label>
        </div>

        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px; padding-top:16px; border-top:1px solid var(--grey-200);">
          <a href="/admin/projects" class="btn">Cancel</a>
          <button type="submit" class="btn btn-primary">
            {% if project.id %}Save Changes{% else %}Create Project{% endif %}
          </button>
        </div>
      </div>
    </form>
  </div>

  {% if project.id %}
  <div class="card" style="margin-top:24px; border:1px solid rgba(239, 68, 68, 0.2); background:rgba(254, 242, 242, 0.6);">
    <div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
      <div>
        <strong style="color:var(--danger); font-size:0.95rem;">Delete Project</strong>
        <div style="font-size:0.84rem; color:var(--grey-600); margin-top:2px;">
          Permanently remove {{ project.title }}. This cannot be undone.
        </div>
      </div>
      <form method="post" action="/admin/projects/{{ project.id }}/delete" onsubmit="return confirm('Delete this project? This cannot be undone.');">
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">
        <button type="submit" class="btn btn-danger">Delete Project</button>
      </form>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}
