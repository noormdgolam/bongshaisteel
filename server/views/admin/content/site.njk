{% extends "admin/layout.njk" %}

{% block title %}Site Copy &amp; SEO — Content Management{% endblock %}

{% block header %}
<h1 style="font-size:1.25rem; font-weight:700; margin:0; color:var(--grey-900);">Site Copy &amp; SEO</h1>
{% endblock %}

{% block content %}
{% set currentSectionKey = "site" %}
{% include "admin/sections/nav.njk" %}

{% if error %}
<div class="error-box">{{ error }}</div>
{% endif %}

<form method="post" action="/admin/content/site">
  <input type="hidden" name="_csrf" value="{{ csrfToken }}">

  {% for group in groups %}
  <div class="card" style="margin-bottom:20px;">
    <h2 style="font-size:1.1rem; font-weight:700; margin:0 0 16px; color:var(--grey-900); border-bottom:1px solid var(--grey-200); padding-bottom:10px;">
      {{ group.title }}
    </h2>

    {% for field in group.fields %}
    <div class="form-row">
      <label for="{{ field.name }}">{{ field.label }}</label>
      {% if field.type == 'textarea' or field.type == 'html' %}
      <textarea id="{{ field.name }}" name="{{ field.name }}" rows="4">{{ field.value or '' }}</textarea>
      {% else %}
      <input type="text" id="{{ field.name }}" name="{{ field.name }}" value="{{ field.value or '' }}">
      {% endif %}
      {% if field.help %}
      <div style="font-size:0.8rem; color:var(--grey-500); margin-top:4px;">
        {{ field.help }}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="card" style="text-align:center; padding:36px; color:var(--grey-500);">
    No site copy groups configured.
  </div>
  {% endfor %}

  <div style="position:sticky; bottom:20px; z-index:10; background:rgba(255,255,255,0.9); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); padding:16px 20px; border-radius:12px; border:1px solid var(--glass-border); box-shadow:0 8px 24px rgba(15,23,42,0.14); display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px;">
    <span style="font-size:0.88rem; color:var(--grey-600); font-weight:600;">
      Changes affect live website copy and metadata.
    </span>
    <button type="submit" class="btn btn-primary" style="padding:10px 24px; font-size:0.95rem;">
      Save Site Copy &amp; Settings
    </button>
  </div>
</form>
{% endblock %}
