{% extends "admin/layout.njk" %}

{% block title %}Product Categories{% endblock %}

{% block header %}
<div style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; width:100%;">
  <div>
    <h1 style="font-size:1.25rem; font-weight:700; margin:0; color:var(--grey-900);">Product Categories</h1>
    <div style="font-size:0.85rem; color:var(--grey-500); margin-top:2px;">Organize products into families, set icons and catalogue hierarchy</div>
  </div>
  <div>
    <a href="/admin/categories/new" class="btn btn-primary">➕ Add Category</a>
  </div>
</div>
{% endblock %}

{% block content %}
<div class="card">
  <div style="margin-bottom:14px; font-size:0.86rem; color:var(--grey-600); font-weight:600;">
    Total Categories: {{ categories.length }}
  </div>

  <div class="table-responsive">
    <table>
      <thead>
        <tr>
          <th style="width:68px;">Image</th>
          <th>Category Name</th>
          <th style="width:140px;">Key</th>
          <th style="width:160px;">Main Category</th>
          <th style="width:110px;">Products</th>
          <th style="width:100px; text-align:center;">Order</th>
          <th style="width:90px; text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for c in categories %}
        <tr>
          <td>
            {% if c.image %}
            <img
              src="{% for part in c.image.split('/') %}{% if part %}/{{ part | urlencode }}{% endif %}{% endfor %}"
              alt="{{ c.name }}"
              class="product-thumb"
              loading="lazy"
            >
            {% else %}
            <div class="product-thumb placeholder-thumb">No img</div>
            {% endif %}
          </td>
          <td>
            <div style="display:flex; align-items:center; gap:8px;">
              {% if c.icon %}<span style="font-size:1.25rem; line-height:1;">{{ c.icon }}</span>{% endif %}
              <div>
                <strong style="color:var(--grey-900); font-size:0.94rem;">{{ c.name }}</strong>
                {% if c.blurb %}
                <div style="font-size:0.82rem; color:var(--grey-500); margin-top:2px; max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">
                  {{ c.blurb }}
                </div>
                {% endif %}
              </div>
            </div>
          </td>
          <td>
            <code style="font-size:0.85rem; color:var(--primary); font-weight:600;">{{ c.key }}</code>
          </td>
          <td>
            <span class="pill pill-muted">{{ c.main_category_name or '-' }}</span>
          </td>
          <td>
            <span class="pill pill-info">{{ c.product_count if c.product_count is defined and c.product_count !== null else 0 }} products</span>
          </td>
          <td style="text-align:center; white-space:nowrap;">
            <div style="display:inline-flex; gap:4px; align-items:center;">
              {% if not loop.first %}
              <form method="post" action="/admin/categories/{{ c.id }}/move" style="display:inline;">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="direction" value="up">
                <button type="submit" class="btn btn-sm" title="Move Up" style="padding:4px 8px; font-size:0.8rem; line-height:1;">↑</button>
              </form>
              {% endif %}
              {% if not loop.last %}
              <form method="post" action="/admin/categories/{{ c.id }}/move" style="display:inline;">
                <input type="hidden" name="_csrf" value="{{ csrfToken }}">
                <input type="hidden" name="direction" value="down">
                <button type="submit" class="btn btn-sm" title="Move Down" style="padding:4px 8px; font-size:0.8rem; line-height:1;">↓</button>
              </form>
              {% endif %}
            </div>
          </td>
          <td style="text-align:right; white-space:nowrap;">
            <a href="/admin/categories/{{ c.id }}/edit" class="btn btn-sm">Edit</a>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="7" style="text-align:center; padding:36px 20px; color:var(--grey-500);">
            No categories defined yet. <a href="/admin/categories/new">Add the first category</a>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <!-- Mobile Card List -->
  <div class="mobile-card-list">
    {% for c in categories %}
    <div class="admin-mobile-card category-card">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:10px; margin-bottom:8px;">
        <div style="display:flex; gap:10px; align-items:center;">
          {% if c.image %}
          <img
            src="{% for part in c.image.split('/') %}{% if part %}/{{ part | urlencode }}{% endif %}{% endfor %}"
            alt="{{ c.name }}"
            class="product-thumb"
            loading="lazy"
          >
          {% elif c.icon %}
          <div class="product-thumb placeholder-thumb" style="font-size:1.4rem;">{{ c.icon }}</div>
          {% else %}
          <div class="product-thumb placeholder-thumb">No img</div>
          {% endif %}
          <div>
            <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
              {% if c.icon and c.image %}<span style="font-size:1.1rem;">{{ c.icon }}</span>{% endif %}
              <strong style="color:var(--grey-900); font-size:0.96rem;">{{ c.name }}</strong>
            </div>
            <code style="font-size:0.82rem; color:var(--primary); font-weight:600;">{{ c.key }}</code>
          </div>
        </div>
        <a href="/admin/categories/{{ c.id }}/edit" class="btn btn-sm" style="white-space:nowrap; flex-shrink:0;">Edit</a>
      </div>

      {% if c.blurb %}
      <div style="font-size:0.84rem; color:var(--grey-600); margin:6px 0;">
        {{ c.blurb }}
      </div>
      {% endif %}

      <div style="display:flex; justify-content:space-between; align-items:center; margin-top:10px; padding-top:8px; border-top:1px dashed rgba(15,23,42,0.08); flex-wrap:wrap; gap:8px;">
        <div style="display:flex; gap:6px; align-items:center; flex-wrap:wrap;">
          {% if c.main_category_name %}
          <span class="pill pill-muted" style="font-size:0.75rem;">{{ c.main_category_name }}</span>
          {% endif %}
          <span class="pill pill-info" style="font-size:0.75rem;">{{ c.product_count if c.product_count is defined and c.product_count !== null else 0 }} products</span>
        </div>

        <div style="display:inline-flex; gap:4px; align-items:center;">
          {% if not loop.first %}
          <form method="post" action="/admin/categories/{{ c.id }}/move" style="display:inline;">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="direction" value="up">
            <button type="submit" class="btn btn-sm" title="Move Up" style="padding:4px 10px; font-size:0.82rem;">↑ Up</button>
          </form>
          {% endif %}
          {% if not loop.last %}
          <form method="post" action="/admin/categories/{{ c.id }}/move" style="display:inline;">
            <input type="hidden" name="_csrf" value="{{ csrfToken }}">
            <input type="hidden" name="direction" value="down">
            <button type="submit" class="btn btn-sm" title="Move Down" style="padding:4px 10px; font-size:0.82rem;">↓ Down</button>
          </form>
          {% endif %}
        </div>
      </div>
    </div>
    {% else %}
    <div style="text-align:center; padding:32px 16px; color:var(--grey-500); background:rgba(255,255,255,0.6); border-radius:10px; border:1px dashed var(--grey-300);">
      No categories defined yet. <a href="/admin/categories/new" style="font-weight:600;">Add the first category</a>
    </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
