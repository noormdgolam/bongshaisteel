<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sign In — Bongshai Steel Admin</title>
<link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
<meta name="robots" content="noindex, nofollow">
<style>
  :root {
    --primary: #1E40AF;
    --primary-dark: #1e3a8a;
    --primary-light: #3b82f6;
    --grey-50: #f8fafc;
    --grey-100: #f1f5f9;
    --grey-200: #e2e8f0;
    --grey-500: #64748b;
    --grey-600: #475569;
    --grey-700: #334155;
    --grey-900: #0f172a;
    --danger: #dc2626;
    --glass: rgba(255, 255, 255, 0.85);
    --glass-border: rgba(255, 255, 255, 0.6);
  }
  * { box-sizing: border-box; }
  html, body { min-height: 100%; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--grey-900);
    background:
      radial-gradient(circle at 15% 15%, rgba(2, 132, 199, 0.28), transparent 45%),
      radial-gradient(circle at 85% 15%, rgba(30, 64, 175, 0.35), transparent 45%),
      radial-gradient(circle at 50% 90%, rgba(15, 23, 42, 0.45), transparent 60%),
      linear-gradient(165deg, #0a1733 0%, #0e2754 40%, #163d7e 75%, #1e40af 100%);
    background-attachment: fixed;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    min-height: 100vh;
  }
  .login-card {
    width: 100%;
    max-width: 420px;
    background: var(--glass);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 32px 28px;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.22), inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }
  .brand-header {
    text-align: center;
    margin-bottom: 24px;
  }
  .brand-logo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: var(--primary);
    color: #ffffff;
    margin-bottom: 12px;
    box-shadow: 0 8px 18px rgba(30, 64, 175, 0.35);
  }
  .brand-title {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--grey-900);
    letter-spacing: -0.02em;
    margin: 0 0 4px;
  }
  .brand-subtitle {
    font-size: 0.88rem;
    color: var(--grey-600);
    margin: 0;
  }
  .error-box {
    background: rgba(254, 242, 242, 0.95);
    color: var(--danger);
    border: 1px solid rgba(220, 38, 38, 0.35);
    border-radius: 8px;
    padding: 12px 14px;
    margin-bottom: 20px;
    font-size: 0.88rem;
    font-weight: 600;
  }
  .lockout-box {
    background: rgba(254, 242, 242, 0.95);
    color: var(--danger);
    border: 1px solid rgba(220, 38, 38, 0.4);
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 20px;
    font-size: 0.9rem;
    font-weight: 700;
    text-align: center;
  }
  .form-row { margin-bottom: 18px; }
  .form-row label {
    display: block;
    font-weight: 600;
    font-size: 0.86rem;
    margin-bottom: 6px;
    color: var(--grey-700);
  }
  .form-row input[type=text], .form-row input[type=password] {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid rgba(15, 23, 42, 0.18);
    border-radius: 8px;
    font-size: 0.95rem;
    font-family: inherit;
    background: rgba(255, 255, 255, 0.85);
    color: var(--grey-900);
    transition: all 0.15s ease;
  }
  .form-row input:focus {
    outline: 2px solid var(--primary-light);
    outline-offset: 1px;
    background: #ffffff;
  }
  .form-row input:disabled {
    background: rgba(226, 232, 240, 0.6);
    color: var(--grey-500);
    cursor: not-allowed;
    border-color: rgba(15, 23, 42, 0.1);
  }
  .btn-submit {
    width: 100%;
    padding: 11px 16px;
    border-radius: 8px;
    border: none;
    background: var(--primary);
    color: #ffffff;
    font-size: 0.96rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(30, 64, 175, 0.3);
    transition: all 0.15s ease;
  }
  .btn-submit:hover:not(:disabled) {
    background: var(--primary-dark);
    box-shadow: 0 6px 18px rgba(30, 64, 175, 0.4);
  }
  .btn-submit:disabled {
    background: var(--grey-500);
    opacity: 0.6;
    cursor: not-allowed;
    box-shadow: none;
  }
</style>
</head>
<body>
<div class="login-card">
  <div class="brand-header">
    <div class="brand-logo">
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18M6 21V8l6-4 6 4v13M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01"/></svg>
    </div>
    <h1 class="brand-title">Bongshai Steel</h1>
    <p class="brand-subtitle">Management Administration Portal</p>
  </div>

  {% if lockedMinutes and lockedMinutes > 0 %}
  <div class="lockout-box">
    Account temporarily locked due to repeated failed attempts. Please try again in {{ lockedMinutes }} minute(s).
  </div>
  {% elif error %}
  <div class="error-box">
    {{ error }}
  </div>
  {% endif %}

  <form method="post" action="/admin/login">
    <input type="hidden" name="_csrf" value="{{ csrfToken }}">

    <div class="form-row">
      <label for="username">Username</label>
      <input
        type="text"
        id="username"
        name="username"
        value="{{ username or '' }}"
        required
        autocomplete="username"
        {% if lockedMinutes and lockedMinutes > 0 %}disabled{% else %}autofocus{% endif %}
      >
    </div>

    <div class="form-row">
      <label for="password">Password</label>
      <input
        type="password"
        id="password"
        name="password"
        required
        autocomplete="current-password"
        {% if lockedMinutes and lockedMinutes > 0 %}disabled{% endif %}
      >
    </div>

    <div style="margin-top:22px;">
      <button
        type="submit"
        class="btn-submit"
        {% if lockedMinutes and lockedMinutes > 0 %}disabled{% endif %}
      >
        Sign In
      </button>
    </div>
  </form>
</div>
</body>
</html>
