# Bongshai Steel CMS — protect internals
# No `Options` directive anywhere in here: hosts that refuse it return 500 for
# the whole folder, which would take the admin area down.
DirectoryIndex index.html index.php

<FilesMatch "^(config\.php|config\.sample\.php|lib\.php|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Never serve backup snapshots or the sign-in throttle file
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^backups/ - [F,L]
</IfModule>

# Out of search results, out of frames, no MIME sniffing
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
</IfModule>
